{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedSim Lab Station",
  "version": "0.1.0",
  "identifier": "edu.medsimlab.station",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "station",
        "title": "MedSim Lab Station",
        "url": "http://medsim-lab.local:3000/station",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "skipTaskbar": true,
        "focus": true,
        "visibleOnAllWorkspaces": true,
        "contentProtected": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["station"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "MedSim Lab student station (kiosk)",
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
